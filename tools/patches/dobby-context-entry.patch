diff --git a/source/TrampolineBridge/Trampoline/trampoline_arm64.cc b/source/TrampolineBridge/Trampoline/trampoline_arm64.cc
--- a/source/TrampolineBridge/Trampoline/trampoline_arm64.cc
+++ b/source/TrampolineBridge/Trampoline/trampoline_arm64.cc
@@ -45,3 +45,13 @@
 }

+// IDH extension only: fake entry consumes the saved pair; generic DobbyHook is unchanged.
+Trampoline *GenerateContextTrampolineBuffer(addr_t from, addr_t to) {
+  TurboAssembler turbo_assembler_(from);
+  turbo_assembler_.stp(X(16), X(17), MemOperand(SP, -16, PreIndex));
+  CodeGen codegen(&turbo_assembler_);
+  codegen.LiteralLdrBranch((uint64_t)to);
+  turbo_assembler_.relocDataLabels();
+  auto block = turbo_assembler_.code_buffer()->dup();
+  return new Trampoline(TRAMPOLINE_ARM64_LDR_BR, block);
+}
 #endif
