 #endif
+// A checkpoint may use only pages allocated exclusively for this purpose.
+// No code caves, MAP_FIXED overwrite, or unverified executable padding.
+static thread_local const char *idh_near_error = "";
+static thread_local char idh_near_error_storage[128];
+extern "C" PUBLIC const char *DobbyNearContextLastError() { return idh_near_error; }
+static MemBlock AllocateOwnedCheckpointIsland(addr_t pos, size_t range) {
+#if defined(__APPLE__)
+  idh_near_error = "no exclusively owned checkpoint page within the strict A64 B range";
+  static stl::vector<simple_linear_allocator_t *> pages;
+  const size_t requested = 32;
+  const addr_t lower = pos > range ? pos - range + 4 : OSMemory::PageSize();
+  const addr_t upper = pos + range;
+  for (auto page : pages) {
+    auto cursor = (addr_t)page->cursor();
+    if (page->capacity - page->size >= requested && cursor >= lower && cursor < upper - requested)
+      return {(addr_t)page->alloc(requested), requested};
+  }
+  if (pages.size() >= 16) { idh_near_error = "owned checkpoint page budget (16) exhausted"; return {}; }
+  const size_t page_size = OSMemory::PageSize();
+  // Let the kernel search its current allocatable map before consulting a
+  // userspace region snapshot. ANYWHERE never replaces an existing mapping.
+  mach_vm_address_t hint = ALIGN_CEIL(lower, page_size);
+  kern_return_t searched = mach_vm_allocate(mach_task_self(), &hint, page_size, VM_FLAGS_ANYWHERE);
+  if (searched == KERN_SUCCESS) {
+    if (hint >= lower && hint < upper && page_size <= upper - hint &&
+        OSMemory::SetPermission((void *)hint,page_size,kReadExecute)) {
+      auto page = new simple_linear_allocator_t((uint8_t *)hint,page_size);
+      pages.push_back(page);return {(addr_t)page->alloc(requested), requested};
+    }
+    mach_vm_deallocate(mach_task_self(),hint,page_size);
+  }
+  auto regions = ProcessRuntime::getMemoryLayout();
+  // The main image may be the first mapped region. Its lower ASLR gap is
+  // valid owned allocation space too; do not discard the first/last gaps.
+  for (size_t i = 0; i <= regions.size(); ++i) {
+    addr_t previous = i ? regions[i - 1].end() : lower;
+    addr_t next = i < regions.size() ? regions[i].addr() : upper;
+    addr_t begin = previous > lower ? previous : lower;
+    begin = ALIGN_CEIL(begin, page_size);
+    addr_t end = next < upper ? next : upper;
+    if (end < begin || end - begin < page_size) continue;
+    mach_vm_address_t allocated = begin;
+    // FIXED without OVERWRITE atomically fails if another mapping won the gap.
+    kern_return_t claimed = mach_vm_allocate(mach_task_self(), &allocated, page_size, VM_FLAGS_FIXED);
+    if (claimed != KERN_SUCCESS) {
+      snprintf(idh_near_error_storage,sizeof(idh_near_error_storage),"exclusive checkpoint allocation failed (Mach %d)",claimed);
+      idh_near_error = idh_near_error_storage;continue;
+    }
+    if (allocated != begin || !OSMemory::SetPermission((void *)allocated,page_size,kReadExecute)) {
+      idh_near_error = "exclusively allocated checkpoint page could not become RX";
+      mach_vm_deallocate(mach_task_self(),allocated,page_size); continue;
+    }
+    auto page = new simple_linear_allocator_t((uint8_t *)allocated,page_size);
+    pages.push_back(page);
+    return {(addr_t)page->alloc(requested), requested};
+  }
+#endif
+  return {};
+}
