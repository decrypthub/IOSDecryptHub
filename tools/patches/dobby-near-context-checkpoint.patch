+// One original A64 instruction is patched. The nearby island saves IP0/IP1
+// before using an indirect branch, preserving the existing IDH context ABI.
+Trampoline *GenerateBreakpointContextTrampolineBuffer(addr_t src, addr_t dst) {
+  (void)dst;
+  TurboAssembler code(src);code.Emit(0xd4200000u | (0x4944u << 5));
+  return new Trampoline(TRAMPOLINE_ARM64_B_XXX,code.code_buffer()->dup());
+}
+
+Trampoline *GenerateNearContextTrampolineBuffer(addr_t src, addr_t dst) {
+  auto allocation = AllocateOwnedCheckpointIsland(src, ARM64_B_XXX_RANGE);
+  if (!allocation.addr() || allocation.addr() % 4) return nullptr;
+  idh_near_error = "";
+  auto delta = (long long)allocation.addr() - (long long)src;
+  if (delta <= -(long long)ARM64_B_XXX_RANGE || delta >= (long long)ARM64_B_XXX_RANGE) return nullptr;
+  TurboAssembler island;
+  island.fixed_addr = allocation.addr();
+  island.stp(X(16), X(17), MemOperand(SP, -16, PreIndex));
+  CodeGen codegen(&island);
+  codegen.LiteralLdrBranch((uint64_t)dst);
+  island.relocDataLabels();
+  auto island_block = AssemblerCodeBuilder::FinalizeFromTurboAssembler(&island);
+  if (!island_block.addr()) return nullptr;
+  auto forward = new Trampoline(FORWARD_TRAMPOLINE_ARM64, island_block);
+  TurboAssembler branch(src);
+  branch.b(delta);
+  return new Trampoline(TRAMPOLINE_ARM64_B_XXX_AND_FORWARD_TRAMP, branch.code_buffer()->dup(), forward);
+}
