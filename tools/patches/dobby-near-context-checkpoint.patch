+// A relocated link instruction must present its *original* LR to the native
+// callee, including on the disabled path. Only the single-word mode can jump
+// directly back to original PC+4; the old 20B relocation remains unchanged.
+int GenNearContextOriginalInstruction(CodeMemBlock *origin,CodeMemBlock *relocated) {
+  if (origin->size != 4) return -1;
+  uint32_t word = *(uint32_t *)origin->addr();
+  bool immediate = (word & 0xfc000000u) == 0x94000000u;
+  bool reg = (word & 0xfffffc1fu) == 0xd63f0000u;
+  bool authZero = (word & 0xfffff81fu) == 0xd63f081fu;
+  bool authTwo = (word & 0xfffff800u) == 0xd73f0800u;
+  if (!immediate && !reg && !authZero && !authTwo) {
+    // Unknown link forms cannot quietly use a fake LR.
+    return (word & 0xfe200000u) == 0xd6200000u ? -1 : 0;
+  }
+  TurboAssembler code;
+  unsigned rn = (word >> 5) & 31;
+  unsigned rm = word & 31;
+  // IP0 is the declared native handoff scratch. A private ABI using it as
+  // a live input to this link is outside this single-instruction boundary.
+  if (!immediate && (rn == 16 || (authTwo && rm == 16))) return -1;
+  if (authZero || authTwo) {
+    uint32_t branch = word & ~(1u << 21); // BLRA* -> BRA*, same key/modifier.
+    code.mov(X(16),X(rn));branch = (branch & ~(31u << 5)) | (16u << 5);
+    if (authTwo && rm == 30) {code.mov(X(17),X(30));branch = (branch & ~31u) | 17u;}
+    // IP0 branch also has the standard call-veneer BTI compatibility. IP1 is
+    // used only if the original LR itself was the authentication modifier.
+    code.Mov(X(30),origin->addr()+4);code.Emit(branch);
+    *relocated = AssemblerCodeBuilder::FinalizeFromTurboAssembler(&code);
+    return relocated->size ? 1 : -1;
+  }
+  if (reg) code.mov(X(16),X(rn));
+  code.Mov(X(30),origin->addr()+4);
+  if (immediate) {
+    int64_t offset = ((int64_t)(int32_t)(word << 6)) >> 4;
+    code.Mov(X(16),origin->addr()+offset);code.br(X(16));
+  } else code.br(X(16));
+  *relocated = AssemblerCodeBuilder::FinalizeFromTurboAssembler(&code);
+  return relocated->size ? 1 : -1;
+}
